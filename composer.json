{
  "name": "elgentos/magento2-oh-dear-checks",
  "description": "Magento 2 module for Oh Dear checks integration.",
  "type": "magento2-module",
  "license": "MIT",
  "require": {
    "vendic/magento2-oh-dear-checks": "^1.8"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Elgentos\\OhDearChecks\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
